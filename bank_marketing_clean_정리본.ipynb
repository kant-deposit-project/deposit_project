    "# 그리드 최적 LightGBM · XGBoost의 fold별 결과\n",
    "lgbm_best = clone(lgbm_grid.best_estimator_)\n",
    "xgb_best  = clone(xgb_grid.best_estimator_)\n",
    "_ = fold_table('LightGBM (grid 최적, + 통화량)', lgbm_best)\n",
    "_ = fold_table('XGBoost (grid 최적, + 통화량)', xgb_best)"
   ]
